# Entornos virtuales
venv/
.venv/
env/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Pesos de modelos YOLO (se descargan automáticamente en models/)
models/*.pt
*.pt

# Videos de prueba (proporcionados por el usuario)
data/videos/*.mp4
data/videos/*.avi
data/videos/*.mov
data/videos/*.MOV
data/videos/*.mkv

# Resultados generados por el benchmark
results/benchmarks/*.csv
results/benchmarks/*.json
results/plots/*.png
results/frames/**
results/benchmark.log

# Resultados generados por el modo de vista previa (no es parte del benchmark)
results/preview/**
results/preview.log

# Región de interés: calibración específica del sitio/video local, y su log
config/roi.json
config/roi_reference.png
config/roi.backup_*.json
results/roi.log

# Calibración por homografía: específica del sitio/video local, y sus reportes.
# config/points.csv NO se ignora: es el formato reproducible que sí se versiona.
config/calibration.json
config/calibration.backup_*.json
results/calibration/**
results/calibration.log
data/aerial/

# Trayectorias de seguimiento (específicas del video/corrida) y su log.
# (Faltaba en el .gitignore desde la fase de seguimiento; se agrega acá.)
results/tracks/**
results/tracking.log

# Resultados de la estimación de velocidad (CSV/JSON/gráficas por corrida,
# banco sintético, validación) y su log.
results/speed/**
results/speed.log

# Jupyter
.ipynb_checkpoints/

# Documentos de prompts (notas de trabajo, no forman parte del proyecto)
*[Pp][Rr][Oo][Mm][Pp][Tt]*.md

# Sistema
.DS_Store
